# Template for the self-hosted container's .env.production (repo root, next to
# Dockerfile). Copy to .env.production and fill in real values — that file is
# gitignored and never leaves the machine it is created on.
#
# Runtime API keys (Anthropic, Apify, Steel, proxies) do NOT belong here — they
# live in app_settings, see the repo root CLAUDE.md. Only what is needed to
# REACH the app and its dependencies at all belongs in this file.
#
# deploy.ps1 treats every uncommented key below as REQUIRED, and refuses to
# build if one is missing, empty, or still holding a <placeholder> value.

# Baked into the client bundle at BUILD time, not read at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Access service token — how the app gets through to Steel.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

STEEL_BASE_URL=

# Public origin, used to build Google OAuth redirect URLs.
APP_URL=

# Inngest Cloud. This deployment uses Cloud, not a self-hosted Inngest — there
# is no Inngest container on the box and there never was one (ADR-014).
#
# Use the PRODUCTION keys, from the Inngest dashboard under Environments →
# Production. A *branch* environment key fails at send time with "400 Branch
# environment name is required": Inngest infers the environment from
# VERCEL_GIT_COMMIT_REF, which a self-hosted container does not have. Setting
# INNGEST_ENV to the branch name also works, but files a production self-host's
# runs under a branch environment, which is not what you want.
#
# Note inngest/client.ts decides dev-vs-cloud on whether INNGEST_EVENT_KEY is
# non-empty, so a placeholder is worse than an absent value — it points the app
# at Cloud with a key that cannot work. Leave these out entirely rather than
# filling them with anything provisional; absent only breaks background jobs.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
